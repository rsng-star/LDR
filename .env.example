# Konfigurasi Aplikasi Tanpilan
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Kunci Rahasia JWT (Wajib diisi string acak minimal 32 karakter di production)
JWT_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_production
JWT_EXPIRES_IN=30d

# Database SQLite Path (Disarankan di dalam folder data/ agar terisolasi dan persisten di Docker)
DATABASE_PATH=./data/tanpilan.db

# Waktu & Lokasi
TIMEZONE_OFFSET_HOURS=7
GPS_INTERVAL_SECONDS=10
DISTANCE_ALERT_THRESHOLD_METERS=100
MAX_HISTORY_DAYS=30
GPS_MAX_ACCURACY_THRESHOLD_METERS=50
GPS_MAX_SPEED_THRESHOLD_MPS=40

# Domain Ngrok Opsional (Jika menggunakan JALANKAN_APLIKASI.bat)
# NGROK_DOMAIN=your-static-domain.ngrok-free.app
